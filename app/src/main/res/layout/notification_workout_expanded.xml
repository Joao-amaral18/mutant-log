<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/notification_panel" android:padding="12dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notification_workout_active" android:textColor="#D3CDE0" android:textSize="11sp" android:layout_marginBottom="6dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="8dp">
<TextView android:id="@+id/notification_exercise" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FAF8FF" android:textSize="16sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
