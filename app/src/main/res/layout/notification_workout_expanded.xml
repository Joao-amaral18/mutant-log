</LinearLayout>
<FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
<Chronometer android:id="@+id/notification_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B388FF" android:textSize="28sp" android:textStyle="bold"/>
<TextView android:id="@+id/notification_idle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B388FF" android:textSize="18sp" android:textStyle="bold"/>
</FrameLayout>
</LinearLayout><TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#D3CDE0" android:textSize="12sp" android:layout_marginTop="4dp"/>
<ProgressBar android:id="@+id/notification_rest_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:progressDrawable="@drawable/notification_progress"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal"><LinearLayout android:id="@+id/notification_action_pause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/notification_pause" android:background="?android:attr/selectableItemBackground">
<ImageView android:id="@+id/notification_icon_pause" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_notification_pause" android:importantForAccessibility="no"/>
<TextView android:id="@+id/notification_label_pause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notification_pause" android:textColor="#FAF8FF" android:textSize="12sp" android:layout_marginTop="4dp" android:importantForAccessibility="no"/>
</LinearLayout><LinearLayout android:id="@+id/notification_action_skip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/notification_skip" android:background="?android:attr/selectableItemBackground">
<ImageView android:id="@+id/notification_icon_skip" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_notification_skip" android:importantForAccessibility="no"/>
<TextView android:id="@+id/notification_label_skip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notification_skip" android:textColor="#FAF8FF" android:textSize="12sp" android:layout_marginTop="4dp" android:importantForAccessibility="no"/>
</LinearLayout><LinearLayout android:id="@+id/notification_action_finish" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:contentDescription="@string/notification_finish" android:background="?android:attr/selectableItemBackground">
<ImageView android:id="@+id/notification_icon_finish" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_notification_finish" android:importantForAccessibility="no"/>
<TextView android:id="@+id/notification_label_finish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/notification_finish" android:textColor="#FAF8FF" android:textSize="12sp" android:layout_marginTop="4dp" android:importantForAccessibility="no"/>
</LinearLayout></LinearLayout></LinearLayout>